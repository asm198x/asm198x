      "targets": [
        {
          "id": "hello-world",
          "cwd": ".",
          "sources": ["helloworld.asm"],
          "reference": ["acme", "--cpu", "6510", "--format", "cbm", "--outfile", "helloworld.prg", "helloworld.asm"],
          "outputs": ["helloworld.prg"]
