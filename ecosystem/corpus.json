    {
      "id": "gbdev-gb-asm-tutorial",
      "name": "GB ASM Tutorial \u2014 Unbricked",
      "cpu": "sm83",
      "dialect": "rgbasm",
      "upstream": "https://github.com/gbdev/gb-asm-tutorial.git",
      "commit": "d127fc21a136eb3a081d358f3bd0d322bd399a29",
      "license": {
        "spdx": "MIT",
        "path": "LICENSE"
      },
      "targets": [
        {
          "id": "unbricked",
          "cwd": "unbricked/bricks",
          "sources": [
            "unbricked/bricks/main.asm",
            "unbricked/bricks/hardware.inc"
          ],
          "reference": [
            "rgbasm",
            "-o",
            "main.o",
            "main.asm"
          ],
          "outputs": [
            "unbricked/bricks/main.o",
            "unbricked/bricks/unbricked.gb"
          ],
          "build": {
            "tools": [
              {
                "name": "rgbasm",
                "probe": [
                  "--version"
                ],
                "versions": [
                  "rgbasm v1.0.3",
                  "rgbasm v1.0.4"
                ]
              },
              {
                "name": "rgbfix",
                "probe": [
                  "--version"
                ],
                "versions": [
                  "rgbfix v1.0.3",
                  "rgbfix v1.0.4"
                ]
              },
              {
                "name": "rgblink",
                "probe": [
                  "--version"
                ],
                "versions": [
                  "rgblink v1.0.3",
                  "rgblink v1.0.4"
                ]
              }
            ],
            "reference": [
              {
                "stage": "assemble",
                "cwd": "unbricked/bricks",
                "argv": [
                  "rgbasm",
                  "-o",
                  "main.o",
                  "main.asm"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "unbricked/bricks/main.o"
                ]
              },
              {
                "stage": "link",
                "cwd": "unbricked/bricks",
                "argv": [
                  "rgblink",
                  "-o",
                  "unbricked.gb",
                  "main.o"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "unbricked/bricks/unbricked.gb"
                ]
              },
              {
                "stage": "finalize",
                "cwd": "unbricked/bricks",
                "argv": [
                  "rgbfix",
                  "-v",
                  "-p",
                  "0xFF",
                  "unbricked.gb"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "unbricked/bricks/unbricked.gb"
                ]
              }
            ],
            "assembler": [
              {
                "stage": "assemble",
                "cwd": "unbricked/bricks",
                "argv": [
                  "asm198x",
                  "--dialect",
                  "rgbasm",
                  "--gb-rom",
                  "main.asm",
                  "-o",
                  "unbricked.gb"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "unbricked/bricks/unbricked.gb"
                ]
              }
            ],
            "compare": [
              {
                "reference": "unbricked/bricks/unbricked.gb",
                "assembler": "unbricked/bricks/unbricked.gb"
              }
            ],
            "directories": [],
            "adapters": [],
            "issues": [
              "https://github.com/asm198x/asm198x/issues/618"
            ]
          }
        }
      ]
