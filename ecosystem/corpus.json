                  "ca65",
                  "example.s",
                  "-g",
                  "-o",
                  "example.o"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "example.o"
                ]
              },
              {
                "stage": "link",
                "cwd": ".",
                "argv": [
                  "ld65",
                  "-o",
                  "example.nes",
                  "-C",
                  "example.cfg",
                  "example.o"
                ],
                "timeout_seconds": 120,
                "outputs": [
                  "example.nes"
                ]
              }
            ],
            "assembler": [
              {
                "stage": "assemble",
